{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "build raylib project",
      "command": "gcc",
      "args": [
        "${workspaceFolder}/main.c",
        "-o",
        "${workspaceFolder}/main.exe",
        "-I",
        "C:\\raylib\\raylib\\src",
        "-L",
        "C:\\raylib\\raylib\\src",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}