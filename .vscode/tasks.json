{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "label": "build raylib project",
      "command": "g++",
      "args": [
        "${workspaceFolder}/*.cpp",
        "-I",
        "C:\\raylib\\raylib\\src",
        "-L",
        "C:\\raylib\\raylib\\src",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-o",
        "${workspaceFolder}/main.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}